# Base Postgres Neon. Sans elle, toute route de données echoue explicitement (B-2).
DATABASE_URL=

# Secret de signature du cookie de session. 32 octets aleatoires au minimum.
# Generation : openssl rand -base64 32
SESSION_SECRET=

# Cle du modele de vision. Serveur uniquement, jamais de prefixe NEXT_PUBLIC_ (AD-4).
# La cle doit avoir un quota actif : sans credit, l'API repond 429 sur chaque
# appel et l'ecran photo affiche « quota epuise ».
# MISTRAL_MODEL est optionnelle. Par defaut mistral-medium-latest, qui lit
# correctement une assiette composee. mistral-small-latest coute moins cher et
# nomme plus grossierement.
MISTRAL_API_KEY=
MISTRAL_MODEL=

# En-tete d'identification exige par les conditions d'usage d'Open Food Facts.
OFF_USER_AGENT=NutriPerso/0.1 (usage personnel; https://github.com/giantprolu/nutri-perso)
